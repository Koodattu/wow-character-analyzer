# Root-level .dockerignore — used by frontend build context (repo root)
# Excludes heavy/unnecessary files from the Docker build context

# Dependencies (each stage installs its own)
**/node_modules

# Build artifacts
frontend/.next
frontend/out
backend/dist
backend/data
**/*.tsbuildinfo

# Version control
.git
**/.git
**/.gitignore

# Documentation (not needed in images)
docs
*.md
LICENSE

# Environment files (passed via compose, not baked into images)
.env*
**/.env*
!.env.example

# Editor / OS
.vscode
.idea
.github
.DS_Store
*.pem

# Docker files themselves
**/Dockerfile
docker-compose*.yml
docker
nginx
init-letsencrypt.sh

# Test / coverage
**/coverage
frontend/test-results

# Lock files are INCLUDED (needed for frozen installs)
# Do NOT ignore bun.lock
